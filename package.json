{
	"name": "obsidian-inline-agents",
	"version": "0.3.0",
	"description": "Turn workflow instructions in a note into buttons that run Claude Code or OpenCode with a live terminal, or hand off to an HTTP agent runtime (OpenClaw, Hermes Agent, any OpenAI-compatible endpoint).",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint src/",
		"test": "node --import tsx --test \"tests/unit/**/*.test.ts\" \"tests/runtime/**/*.test.ts\""
	},
	"keywords": [
		"obsidian-plugin",
		"claude-code",
		"opencode",
		"ai-agent",
		"terminal",
		"automation"
	],
	"author": "Dan Fletcher",
	"license": "MIT",
	"devDependencies": {
		"@typescript-eslint/eslint-plugin": "^8.68.0",
		"@typescript-eslint/parser": "^8.68.0",
		"esbuild": "^0.21.5",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "^1.5.7",
		"tslib": "2.6.2",
		"tsx": "^4.23.15",
		"typescript": "5.4.5"
	},
	"dependencies": {
		"@types/node": "^20.14.2",
		"@xterm/addon-fit": "^0.10.0",
		"@xterm/xterm": "^5.5.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/danrfletcher/obsidian-inline-agents.git"
	}
}
